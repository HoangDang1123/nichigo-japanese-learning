{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".test-dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "test/css-modules.d.ts",
    "src/api/index.ts",
    "src/api/auth.ts",
    "src/api/auth.test.ts",
    "src/store/index.ts",
    "src/store/slices/auth-slice.ts",
    "src/lib/auth/auth-validation.ts",
    "src/components/theme-switcher-icons.tsx",
    "src/components/theme-switcher-icons.test.tsx",
    "src/components/ui/skeleton.tsx",
    "src/components/ui/skeleton.test.tsx",
    "src/components/home/home-loading.ts",
    "src/components/home/home-skeleton.tsx",
    "src/components/home/home-study-desk.tsx",
    "src/components/skills/kana-chart-data.test.ts",
    "src/components/skills/kana-drawer.test.tsx",
    "src/components/skills/kana-stroke-guidance.test.tsx",
    "src/components/skills/vocabulary/vocabulary-logic.test.ts",
    "src/components/skills/vocabulary/quiz-runner.test.tsx",
    "src/components/skills/vocabulary/study-rail.test.tsx"
  ]
}
