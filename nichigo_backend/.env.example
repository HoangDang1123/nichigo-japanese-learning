# Template only. Spring Boot does not load .env files automatically.
# Configure these in IntelliJ Run/Debug Configuration > Environment variables,
# or export them in the shell before running ./mvnw spring-boot:run.
# Keep real values in your ignored local .env or IDE/environment settings.

# PostgreSQL JDBC connection URL, for example jdbc:postgresql://localhost:5432/nichigo
DB_URL=
# PostgreSQL database user
DB_USERNAME=
# PostgreSQL database password (keep private)
DB_PASSWORD=
# HTTP port; Spring defaults to 8080 when unset
SERVER_PORT=
# Comma-separated exact browser origins, no trailing slash; e.g. http://localhost:3000
ALLOWED_ORIGINS=
# Set true in production HTTPS. Local HTTP development may use false.
SESSION_COOKIE_SECURE=
# Cookie SameSite policy: Lax locally; None requires Secure and HTTPS for cross-site use.
SESSION_COOKIE_SAME_SITE=
