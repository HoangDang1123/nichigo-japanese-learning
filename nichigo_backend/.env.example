# nichigo_backend — environment variable reference
#
# Copy this file to .env for local overrides (it is git-ignored).
# Never commit real secrets to source control.

# HTTP port for the Spring Boot server (default: 8080)
SERVER_PORT=8080

# Comma-separated list of CORS-allowed frontend origins (no trailing slash)
# Local dev default — restrict to deployed Vercel URL in production
ALLOWED_ORIGINS=http://localhost:3000

# Session cookie settings. For a cross-site production frontend, use
# SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAME_SITE=None.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
