# ── Secrets & local env ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Next.js (nichigo_frontend) ───────────────────────────────────────────────
nichigo_frontend/node_modules/
nichigo_frontend/.next/
nichigo_frontend/out/
nichigo_frontend/.vercel/
nichigo_frontend/dist/
nichigo_frontend/.cache/
