{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "textJa",
    "translationVi"
  ],
  "properties": {
    "textJa": {
      "type": "string",
      "maxLength": 1000
    },
    "translationVi": {
      "type": "string",
      "maxLength": 1000
    },
    "annotationVi": {
      "type": "string",
      "maxLength": 1000
    },
    "itemRefs": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          },
          "reading": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          }
        }
      }
    },
    "kanjiDetailCandidate": {
      "type": "string",
      "enum": [
        "yes"
      ]
    }
  }
}
